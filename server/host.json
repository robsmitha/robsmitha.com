{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            }
        }
    },
    "extensions": {
        "queues": {
            "batchSize": 1,
            "newBatchThreshold": 0,
            "maxPollingInterval": "00:00:05",
            "maxDequeueCount": 5,
            "visibilityTimeout": "00:01:00"
        }
    }
}
